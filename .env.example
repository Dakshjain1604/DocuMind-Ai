# Copy to .env and fill in. `docker compose up --build -d` reads this file
# from the repo root. Nothing here is a real credential.

# REQUIRED — must be >=16 chars and identical across backend + frontend.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# ── Provider (the one env the app cannot infer) ──────────────────────────────
# openrouter (default) | groq | nvidia — see microService/.env.example for the
# per-provider model chains and the alternative keys (GROQ_API_KEY, NVIDIA_API_KEY).
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional port overrides if 3000/8000 are taken locally.
# FRONTEND_PORT=3000
# BACKEND_PORT=8000