# Copy to .env and fill in. Nothing here is a real credential.
#
# Only the keys below are needed to run the service. settings.py reads ~60
# variables in total; the rest are retrieval tuning knobs with sensible
# defaults — see app/config/settings.py for the full list.

# ── Provider ────────────────────────────────────────────────────────────────
# openrouter (default) | groq | nvidia
LLM_PROVIDER=openrouter

OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Comma-separated fallback chains, tried left to right per role.
OPENROUTER_MODEL_EXTRACT=deepseek/deepseek-chat-v3-0324:free,meta-llama/llama-3.3-70b-instruct:free,openai/gpt-4o-mini
OPENROUTER_MODEL_ANSWER=meta-llama/llama-3.3-70b-instruct:free,deepseek/deepseek-chat-v3-0324:free,openai/gpt-4o-mini
OPENROUTER_MODEL_REWRITE=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_MODEL_RERANK=qwen/qwen-2.5-7b-instruct:free

# Alternatives, used when LLM_PROVIDER is set to them.
# GROQ_API_KEY=gsk_...
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL_EXTRACT=llama-3.3-70b-versatile,llama-3.1-8b-instant
# GROQ_MODEL_ANSWER=llama-3.3-70b-versatile,deepseek-r1-distill-llama-70b
# GROQ_MODEL_REWRITE=llama-3.1-8b-instant
# GROQ_MODEL_RERANK=llama-3.1-8b-instant

# NVIDIA_API_KEY=nvapi-...
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL_EXTRACT=meta/llama-3.3-70b-instruct,meta/llama-3.1-8b-instruct
# NVIDIA_MODEL_ANSWER=meta/llama-3.3-70b-instruct
# NVIDIA_MODEL_REWRITE=meta/llama-3.1-8b-instruct
# NVIDIA_MODEL_RERANK=meta/llama-3.1-8b-instruct

# ── Embeddings ──────────────────────────────────────────────────────────────
# Local by default. An "nvidia/..." value uses NVIDIA NIM and requires
# NVIDIA_API_KEY. Changing this INVALIDATES existing indexes — embeddings of
# different dimensions cannot be queried against the same Chroma collection.
RAG_EMBED_MODEL=BAAI/bge-small-en-v1.5

# ── Indexing ────────────────────────────────────────────────────────────────
# Parent chunks sampled for entity/relation extraction. Above this, the graph
# is built from an even-stride sample and the SSE stream emits a warning.
RAG_MAX_GRAPH_CHUNKS=25
# Per-chunk budget for one extraction call, in seconds. Too low and extraction
# times out on every chunk, which yields an empty knowledge graph.
RAG_GRAPH_EXTRACT_TIMEOUT_S=60
RAG_GRAPH_CONCURRENCY=5

# ── Retrieval ───────────────────────────────────────────────────────────────
# cross_encoder (default) | llm | off
RAG_RERANK_MODE=cross_encoder

# Max output tokens for the final answer generation call. No provider default
# is trustworthy across models/providers, so this is set explicitly.
RAG_ANSWER_MAX_TOKENS=2048

# Upper bound (seconds) for each retrieval leg (vector/BM25/graph). A leg that
# hangs past this is treated as "no results" rather than held forever.
RAG_RETRIEVAL_TIMEOUT_S=30

# ── Paths and limits ────────────────────────────────────────────────────────
RAG_PERSIST_DIR=./local_chroma
RAG_MAX_CACHE_DOCS=3
RAG_MAX_FILE_MB=100

# ── Service ─────────────────────────────────────────────────────────────────
# Browser origins allowed to call this service directly, comma-separated.
RAG_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RAG_LOG_LEVEL=INFO

# Only needed for OCR of scanned PDFs, and only if tesseract is not on PATH.
# RAG_TESSERACT_CMD=/opt/homebrew/bin/tesseract
# RAG_OCR_LANGUAGES=eng

# ── Auth ────────────────────────────────────────────────────────────────────
# REQUIRED, no fallback — the service refuses to start without it (min 16
# chars). Must be the exact same value as the frontend's JWT_SECRET
# (frontend/.env), since the frontend signs the tokens this service verifies.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# ── Rate limiting ───────────────────────────────────────────────────────────
# Requests per minute, per client IP. /index is capped tighter since it's the
# expensive path (embedding + LLM graph extraction over a whole document).
RAG_RATE_LIMIT_QUERY_PER_MIN=20
RAG_RATE_LIMIT_INDEX_PER_MIN=5
RAG_RATE_LIMIT_STUDIO_PER_MIN=10

# Trust X-Forwarded-For for rate limiting. ONLY set true behind a reverse proxy
# that overwrites that header (traefik/nginx/compose-frontend); with it true on
# a directly-exposed service, callers can rotate buckets with a spoofed header.
RAG_TRUST_PROXY=false
