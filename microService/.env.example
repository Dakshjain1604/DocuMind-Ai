# Provider Selection: openrouter (default) | groq | nvidia
LLM_PROVIDER=openrouter

# OpenAI (embeddings only — text-embedding-3-large)
OPENAI_API_KEY=sk-...

# OpenRouter (chat completions)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenRouter model chains per role
OPENROUTER_MODEL_EXTRACT=deepseek/deepseek-chat-v3-0324:free,meta-llama/llama-3.3-70b-instruct:free,openai/gpt-4o-mini
OPENROUTER_MODEL_ANSWER=meta-llama/llama-3.3-70b-instruct:free,deepseek/deepseek-chat-v3-0324:free,openai/gpt-4o-mini
OPENROUTER_MODEL_REWRITE=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_MODEL_RERANK=qwen/qwen-2.5-7b-instruct:free

# Groq (chat completions)
GROQ_API_KEY=gsk_...
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Groq model chains per role
GROQ_MODEL_EXTRACT=llama-3.3-70b-versatile,llama-3.1-8b-instant
GROQ_MODEL_ANSWER=llama-3.3-70b-versatile,deepseek-r1-distill-llama-70b
GROQ_MODEL_REWRITE=llama-3.1-8b-instant
GROQ_MODEL_RERANK=llama-3.1-8b-instant

# NVIDIA NIM (chat completions)
NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# NVIDIA model chains per role
NVIDIA_MODEL_EXTRACT=z-ai/glm-5.2,meta/llama-3.3-70b-instruct,meta/llama-3.1-8b-instruct
NVIDIA_MODEL_ANSWER=z-ai/glm-5.2,meta/llama-3.3-70b-instruct
NVIDIA_MODEL_REWRITE=z-ai/glm-5.2,meta/llama-3.1-8b-instruct
NVIDIA_MODEL_RERANK=z-ai/glm-5.2,meta/llama-3.1-8b-instruct

# Feature flags
RAG_ENABLE_RERANK=false

# Indexing
# Per-chunk budget for one graph-extraction LLM call, in seconds. Too low and
# extraction times out on every chunk, which yields an empty knowledge graph.
RAG_GRAPH_EXTRACT_TIMEOUT_S=60

# Cache / paths
RAG_PERSIST_DIR=./local_chroma
RAG_MAX_CACHE_DOCS=3
RAG_MAX_FILE_MB=100


