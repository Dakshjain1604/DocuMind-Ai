# syntax=docker/dockerfile:1

# ── deps ──────────────────────────────────────────────────────────────────────
# `npm ci` needs the exact, committed package-lock.json.
FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

# ── build ─────────────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# next build validates lib/auth.ts against a configured secret (CI does the
# same). The secret itself is re-fed at runtime from the environment — the
# build arg is validation-only, not the source of truth.
ARG JWT_SECRET
ENV JWT_SECRET=$JWT_SECRET

RUN npm run build

# ── runtime ───────────────────────────────────────────────────────────────────
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

RUN addgroup -S nextjs && adduser -S nextjs -G nextjs

# next.config.ts turns on `output: "standalone"`, so server.js + node_modules
# under .next/standalone already contain everything the app needs at runtime.
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nextjs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nextjs /app/.next/static ./.next/static

USER nextjs
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:3000/signin || exit 1

CMD ["node", "server.js"]