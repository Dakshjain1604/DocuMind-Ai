# Copy to .env and fill in. Nothing here is a real credential.

# Backend service the /api/rag/* proxy routes talk to.
RAG_BACKEND_URL=http://localhost:8000

# Session signing key. REQUIRED — there is deliberately no fallback, so signin
# fails loudly if it is unset rather than falling back to a well-known default
# committed in the source.
# Generate one with: openssl rand -hex 32
JWT_SECRET=replace-me-with-a-long-random-value

# Optional. When unset, accounts are stored in a local JSON file instead.
MONGODB_URI=
